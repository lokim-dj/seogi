<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing of Seogi's own storage leaves the phone through Android backup or
    a phone-to-phone transfer: the list, the settings and recordings in
    progress stay here. The recordings themselves are in Recordings/서기/ and
    in the user's own Drive.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
